# Copy to .env and adjust. Every value is optional for a local run (npm run cluster sets its own).

# ---------------------------------------------------------------- whole cluster
# Signs edge tickets and authenticates internal calls. Same value on every service. Required in production.
CLUSTER_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------- orchestrator (internal only)
ORCHESTRATOR_LISTEN_IP=127.0.0.1
ORCHESTRATOR_PORT=4200
# A node that misses heartbeats this long is treated as dead.
NODE_TIMEOUT_MS=5000
# Where session and quality records go (JSON lines until ClickHouse).
# DATA_DIR=./data

# ---------------------------------------------------------------- allocator (public access point)
ALLOCATOR_LISTEN_IP=0.0.0.0
ALLOCATOR_PORT=4100
ORCHESTRATOR_URL=http://127.0.0.1:4200
# Customer projects until the platform database exists.
# PROJECTS_FILE=./config/projects.json

# ---------------------------------------------------------------- media node
NODE_ID=edge-dxb-1
REGION=dxb
HTTP_LISTEN_IP=127.0.0.1
HTTP_PORT=3000
# What clients connect to (behind Caddy/TLS in production).
PUBLIC_WS_URL=wss://edge-dxb-1.example.com/ws
# What other media nodes connect to for cascading (private network).
CLUSTER_WS_URL=ws://10.0.0.11:3000/cluster
# Peers this node takes before rooms spill to another node.
NODE_MAX_PEERS=2000
HEARTBEAT_MS=2000
DRAIN_TIMEOUT_MS=10000
# Serve HTTPS/WSS directly instead of behind a proxy:
# TLS_CERT_FILE=./certs/cert.pem
# TLS_KEY_FILE=./certs/key.pem

# mediasoup: one worker per CPU core by default.
# MEDIASOUP_NUM_WORKERS=4
# The server's public IP (or a DNS name that resolves to it). Required on any cloud server.
ANNOUNCED_ADDRESS=203.0.113.10
# Worker N listens on WEBRTC_BASE_PORT + N, UDP and TCP. Open that range in the firewall.
WEBRTC_BASE_PORT=44444
MEDIASOUP_LOG_LEVEL=warn
# Node-to-node RTP for cascading. Use the private network.
PIPE_LISTEN_IP=0.0.0.0
PIPE_ANNOUNCED_ADDRESS=10.0.0.11

# TURN (coturn with use-auth-secret). Leave empty to run without TURN.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SECRET=change-me-to-a-long-random-string
TURN_CREDENTIAL_TTL=21600

# Rooms
ROOM_MAX_SPEAKERS=16
ROOM_MAX_PEERS=5000
AUDIO_LEVEL_INTERVAL_MS=500
TOKEN_WARNING_SECONDS=30
MAX_BAN_SECONDS=86400

LOG_LEVEL=info
